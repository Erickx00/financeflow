# Ambiente local do FinanceFlow.
# Copie para .env e ajuste os valores. Nunca versione o .env.
DB_URL=jdbc:postgresql://localhost:5432/financeflow
DB_USERNAME=financeflow
DB_PASSWORD=change_me
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_EXPIRATION_SECONDS=3600
REDIS_HOST=localhost
REDIS_PORT=6379
# Fuso usado para definir o "hoje" das regras de negocio
APP_TIME_ZONE=America/Sao_Paulo
